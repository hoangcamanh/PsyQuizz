# ==============================================================================
# PSYQUIZZ — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - Do NOT place real secrets, API keys, or private certificates into this file.
# - Copy this file to .env.local for local development.
# - Never prefix private backend secrets with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE FIREBASE CONFIGURATION (Publicly visible in browser bundle)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase App Check (reCAPTCHA v3 or Enterprise Site Key)
NEXT_PUBLIC_APP_CHECK_SITE_KEY=your-recaptcha-v3-site-key
# Set to 'true' in development to enable debug token workflow
NEXT_PUBLIC_APP_CHECK_DEBUG=true

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE AI & RETRIEVAL CONFIGURATION (Confidential - Node.js Server Only)
# ------------------------------------------------------------------------------
# Google Gemini API Key for Server-Side Orchestration & Verified RAG
# In production, this can also be retrieved from Google Cloud Secret Manager.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. SERVER-SIDE FIREBASE ADMIN SDK (Privileged Backend Access)
# ------------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# For local dev: multiline private key with escaped newlines (\n)
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. APPLICATION & ENVIRONMENT SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

